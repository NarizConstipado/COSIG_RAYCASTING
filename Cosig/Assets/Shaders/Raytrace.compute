#pragma kernel CSMain

#include "UnityCG.cginc"

struct GPUObject
{
    int type;
    int materialIndex;
    float3 center;
    float radius;
    float3 v0;
    float3 v1;
    float3 v2;
    float3 min, max;
    float4x4 matWorld;
    float4x4 invMatWorld;
    float4x4 invTranspMatWorld;
};

struct GPUMaterial
{
    float3 color;
    float ambient;
    float diffuse;
    float specular;
    float refraction;
    float refractionIndex;
};

struct GPULight
{
    float3 position;
    float3 color;
};

struct HitResult
{
    bool found;
    float tmin;
    float3 pointTransform;
    float3 normal;
    GPUMaterial material;
};

StructuredBuffer<GPUObject> objects;
StructuredBuffer<GPUMaterial> materials;
StructuredBuffer<GPULight> lights;

RWTexture2D<float4> Result;

cbuffer SettingsBuffer
{
    int recursionDepth;
    float3 bgColor;
};

cbuffer CameraBuffer
{
    float3 camPos;
    float3 camForward;
    float3 camRight;
    float3 camUp;
    float fov;
    int width;
    int height;
};

static const float EPSILON = 1e-4f;
static const float EPSILON_RAY = 1e-6f;
static const float MAX_DISTANCE = 1e20f;

HitResult IntersectSphere(float3 rayOrigin, float3 rayDir, GPUObject obj, int matIndex)
{
    HitResult result = (HitResult)0;
    result.found = false;
    result.tmin = MAX_DISTANCE;

    float3 O = mul(obj.invMatWorld, float4(rayOrigin, 1.0f)).xyz;
    float3 D = normalize(mul(obj.invMatWorld, float4(rayDir, 0.0f)).xyz);

    // Esfera unitária no espaço local
    float3 L = O;
    float a = dot(D, D);
    float b = 2.0f * dot(D, L);
    float c = dot(L, L) - 0.25f; // raio = 0.5

    float disc = b * b - 4.0f * a * c;
    if (disc < 0.0f)
        return result;

    float sqrtDisc = sqrt(disc);
    float t0 = (-b - sqrtDisc) / (2.0f * a);
    float t1 = (-b + sqrtDisc) / (2.0f * a);

    float tLocal = (t0 > EPSILON_RAY) ? t0 : ((t1 > EPSILON_RAY) ? t1 : -1.0f);
    if (tLocal < 0.0f)
        return result;

    float3 localPoint = O + tLocal * D;
    float3 worldPoint = mul(obj.matWorld, float4(localPoint, 1.0f)).xyz;
    float tWorld = length(worldPoint - rayOrigin);

    if (tWorld > EPSILON_RAY && tWorld < result.tmin)
    {
        result.found = true;
        result.tmin = tWorld;
        result.pointTransform = worldPoint;

        float3 localNormal = normalize(localPoint);
        result.normal = normalize(
            mul(obj.invTranspMatWorld, float4(localNormal, 0.0f)).xyz
        );

        result.material = materials[matIndex];
    }

    return result;
}

HitResult IntersectTriangle(float3 rayOrigin, float3 rayDir, GPUObject obj, int matIndex)
{
    HitResult result = (HitResult)0;
    result.found = false;
    result.tmin = MAX_DISTANCE;

    float3 e1 = obj.v1 - obj.v0;
    float3 e2 = obj.v2 - obj.v0;
    float3 pvec = cross(rayDir, e2);
    float det = dot(e1, pvec);

    if (abs(det) < EPSILON_RAY)
        return result;

    float invDet = 1.0f / det;
    float3 tvec = rayOrigin - obj.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < 0.0f || u > 1.0f)
        return result;

    float3 qvec = cross(tvec, e1);
    float v = dot(rayDir, qvec) * invDet;

    if (v < 0.0f || u + v > 1.0f)
        return result;

    float t = dot(e2, qvec) * invDet;

    if (t > EPSILON_RAY && t < result.tmin)
    {
        float3 hitPoint = rayOrigin + t * rayDir;
        result.found = true;
        result.tmin = t;
        result.pointTransform = hitPoint;
        result.normal = normalize(cross(e1, e2));
        result.material = materials[matIndex];
    }

    return result;
}

HitResult IntersectBox(float3 rayOrigin, float3 rayDir, GPUObject obj, int matIndex)
{
    HitResult result = (HitResult)0;
    result.found = false;
    result.tmin = MAX_DISTANCE;

    float3 O = mul(obj.invMatWorld, float4(rayOrigin, 1.0f)).xyz;
    float3 D = normalize(mul(obj.invMatWorld, float4(rayDir, 0.0f)).xyz);

    float3 boxMin = obj.min;
    float3 boxMax = obj.max;

    float tnear = -MAX_DISTANCE;
    float tfar = MAX_DISTANCE;

    for (int i = 0; i < 3; i++)
    {
        float origin = O[i];
        float dir = D[i];
        float minVal = boxMin[i];
        float maxVal = boxMax[i];

        if (abs(dir) < EPSILON_RAY)
        {
            if (origin < minVal || origin > maxVal)
                return result;
        }
        else
        {
            float t1 = (minVal - origin) / dir;
            float t2 = (maxVal - origin) / dir;
            
            if (t1 > t2)
            {
                float tmp = t1;
                t1 = t2;
                t2 = tmp;
            }

            tnear = max(tnear, t1);
            tfar = min(tfar, t2);

            if (tnear > tfar || tfar < 0.0f)
                return result;
        }
    }

    if (tnear > EPSILON_RAY)
    {
        float3 localPoint = O + tnear * D;
        float3 worldPoint = mul(obj.matWorld, float4(localPoint, 1.0f)).xyz;
        float tWorld = length(worldPoint - rayOrigin);

        if (tWorld > EPSILON_RAY && tWorld < result.tmin)
        {
            float3 n = float3(0, 0, 0);
            float epsilon = 1e-4f;

            if (abs(localPoint.x - boxMin.x) < epsilon) n = float3(-1, 0, 0);
            else if (abs(localPoint.x - boxMax.x) < epsilon) n = float3(1, 0, 0);
            else if (abs(localPoint.y - boxMin.y) < epsilon) n = float3(0, -1, 0);
            else if (abs(localPoint.y - boxMax.y) < epsilon) n = float3(0, 1, 0);
            else if (abs(localPoint.z - boxMin.z) < epsilon) n = float3(0, 0, -1);
            else n = float3(0, 0, 1);

            result.found = true;
            result.tmin = tWorld;
            result.pointTransform = worldPoint;
            result.normal = normalize(mul(obj.invTranspMatWorld, float4(n, 0.0f)).xyz);
            result.material = materials[matIndex];
        }
    }

    return result;
}

bool IsInShadow(float3 hitPoint, float3 hitNormal, float3 lightDir, float lightDist)
{
    float3 shadowOrigin = hitPoint + hitNormal * EPSILON;
    
    for (int i = 0; i < (int)objects.Length; i++)
    {
        GPUObject obj = objects[i];
        HitResult shadowHit = (HitResult)0;

        if (obj.type == 0) // Esfera
            shadowHit = IntersectSphere(shadowOrigin, lightDir, obj, obj.materialIndex);
        else if (obj.type == 1) // Triangulo
            shadowHit = IntersectTriangle(shadowOrigin, lightDir, obj, obj.materialIndex);
        else if (obj.type == 2) // Cubo
            shadowHit = IntersectBox(shadowOrigin, lightDir, obj, obj.materialIndex);

        if (shadowHit.found && shadowHit.tmin < lightDist && shadowHit.tmin > 1e-4f)
            return true;
    }

    return false;
}

float3 TraceRay(float3 rayOrigin, float3 rayDir)
{
    float3 radiance = float3(0, 0, 0);
    float3 throughput = float3(1, 1, 1);

    for (int depth = 0; depth <= recursionDepth; depth++)
    {
        HitResult hit;
        hit.found = false;
        hit.tmin = MAX_DISTANCE;

        for (int i = 0; i < (int)objects.Length; i++)
        {
            GPUObject obj = objects[i];
            HitResult h;

            if (obj.type == 0)
                h = IntersectSphere(rayOrigin, rayDir, obj, obj.materialIndex);
            else if (obj.type == 1)
                h = IntersectTriangle(rayOrigin, rayDir, obj, obj.materialIndex);
            else
                h = IntersectBox(rayOrigin, rayDir, obj, obj.materialIndex);

            if (h.found && h.tmin < hit.tmin)
                hit = h;
        }

        if (!hit.found) 
        {
             radiance += throughput * bgColor;
             break;
        }

        float3 localColor = hit.material.color * hit.material.ambient;

        for (int li = 0; li < (int)lights.Length; li++)
        {
            GPULight light = lights[li];
            float3 L = light.position - hit.pointTransform;
            float dist = length(L);
            L = normalize(L);

            float NdotL = dot(hit.normal, L);
            if (NdotL > 0 && !IsInShadow(hit.pointTransform, hit.normal, L, dist))
            {
                localColor += light.color *
                              hit.material.color *
                              hit.material.diffuse *
                              NdotL;
            }
        }

        if ((int)lights.Length > 0)
            localColor /= (int)lights.Length;

        radiance += throughput * localColor;

        float cosThetaV = -dot(rayDir, hit.normal);

        float3 newDir;
        float3 newOrigin;
        bool validBounce = false;

        if (hit.material.specular > 0.0f)
        {
            newDir = normalize(rayDir + 2.0f * cosThetaV * hit.normal);
            newOrigin = hit.pointTransform + EPSILON * hit.normal;
            throughput *= hit.material.specular * hit.material.color;
            validBounce = true;
        }
        
        if (hit.material.refraction > 0.0f)
        {
            float3 n = hit.normal;
            float eta;

            if (cosThetaV > 0.0f)
            {
                eta = 1.0f / hit.material.refractionIndex;
            } 
            else
            {
                eta = hit.material.refractionIndex;
                n = -n;
                cosThetaV = -cosThetaV;
            }
                

            float k = 1.0f - eta * eta * (1.0f - cosThetaV * cosThetaV);
            if (k >= 0.0f)
            {
                float cosThetaR = sqrt(k);
                newDir = eta * rayDir + (eta * cosThetaV - cosThetaR) * n;
                newDir = normalize(newDir);

                newOrigin = hit.pointTransform - n * EPSILON;

                throughput *= hit.material.refraction * hit.material.color;
                validBounce = true;
            }
        }

        if (!validBounce)
            break;

        rayOrigin = newOrigin;
        rayDir = newDir;
    }

    return saturate(radiance);
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)width || id.y >= (uint)height)
        return;

    float u = (id.x + 0.5f) / width * 2.0f - 1.0f;
    float v = (id.y + 0.5f) / height * 2.0f - 1.0f;

    float aspect = (float)width / (float)height;
    float3 rayDir = normalize(
        camForward + 
        u * aspect * camRight * tan(fov * 0.5f) + 
        v * camUp * tan(fov * 0.5f)
    );
    float3 rayOrigin = camPos;

    float3 color = TraceRay(rayOrigin, rayDir);

    color = clamp(color, float3(0, 0, 0), float3(1, 1, 1));

    Result[id.xy] = float4(color, 1.0f);
}