#pragma kernel CSMain

#include "UnityCG.cginc"

// =============================================================================
// STRUCTURES
// =============================================================================

struct GPUObject
{
    int type;
    int materialIndex;
    float3 center;
    float radius;
    float3 v0;
    float3 v1;
    float3 v2;
    float3 min, max;
    float4x4 matWorld;
    float4x4 invMatWorld;
    float4x4 invTranspMatWorld;
};

struct GPUMaterial
{
    float3 color;
    float ambient;
    float diffuse;
    float specular;
    float refraction;
    float refractiveIndex;
};

struct GPULight
{
    float3 position;
    float3 color;
};

struct Hit
{
    bool found;
    float tmin;
    float3 point;
    float3 normal;
    GPUMaterial material;
    int objectIndex;
};

struct BVHNode
{
    float3 aabbMin;
    float3 aabbMax;
    int leftChild;       // -1 if leaf
    int rightChild;      // -1 if leaf
    int firstPrimitive; // leaf: index into primitives array
    int primitiveCount; // leaf: number of primitives
};

// =============================================================================
// BUFFERS
// =============================================================================

StructuredBuffer<GPUObject> objects;
StructuredBuffer<GPUMaterial> materials;
StructuredBuffer<GPULight> lights;
StructuredBuffer<BVHNode> bvhNodes;
StructuredBuffer<int> bvhPrimitives; // maps primitive index to object index

RWTexture2D<float4> Result;

cbuffer CameraBuffer
{
    float3 camPos;
    float3 camForward;
    float3 camRight;
    float3 camUp;
    float fov;
    int width;
    int height;
    float3 backgroundColor;
};

cbuffer BVHBuffer
{
    int bvhNodeCount;
    int bvhPrimitiveCount;
    int objectCount;
    int lightCount;
};

const float EPS = 1e-6;
const int MAX_TRACE_DEPTH = 3;
const int MAX_BVH_STACK = 64;

// =============================================================================
// FORWARD DECLARATIONS
// =============================================================================

Hit TraceRay(float3 rayOrigin, float3 rayDir, int depth);
bool TestSphereIntersection(float3 rayOrigin, float3 rayDir, GPUObject sphere, out float t, out float3 hitPoint, out float3 hitNormal);
bool TestTriangleIntersection(float3 rayOrigin, float3 rayDir, GPUObject tri, out float t, out float3 hitPoint, out float3 hitNormal);
bool TestBoxIntersection(float3 rayOrigin, float3 rayDir, GPUObject box, out float t, out float3 hitPoint, out float3 hitNormal);
bool IntersectAABB(float3 rayOrigin, float3 rayDir, float3 aabbMin, float3 aabbMax, out float tEnter, out float tExit);

// =============================================================================
// AABB INTERSECTION (for BVH traversal)
// =============================================================================

bool IntersectAABB(float3 rayOrigin, float3 rayDir, float3 aabbMin, float3 aabbMax, out float tEnter, out float tExit)
{
    tEnter = -1e20;
    tExit = 1e20;

    for (int i = 0; i < 3; i++)
    {
        float invDir = 1.0 / (rayDir[i] + 1e-8); // avoid division by zero
        float t1 = (aabbMin[i] - rayOrigin[i]) * invDir;
        float t2 = (aabbMax[i] - rayOrigin[i]) * invDir;

        if (invDir < 0.0)
        {
            float tmp = t1;
            t1 = t2;
            t2 = tmp;
        }

        tEnter = max(tEnter, t1);
        tExit = min(tExit, t2);

        if (tEnter > tExit)
            return false;
    }

    return tExit >= 0.0;
}

// =============================================================================
// SPHERE INTERSECTION TEST
// =============================================================================

bool TestSphereIntersection(float3 rayOrigin, float3 rayDir, GPUObject sphere, out float t, out float3 hitPoint, out float3 hitNormal)
{
    t = -1.0;
    hitPoint = float3(0, 0, 0);
    hitNormal = float3(0, 0, 0);

    float3 L = rayOrigin - sphere.center;
    float a = dot(rayDir, rayDir);
    float b = 2.0 * dot(rayDir, L);
    float c = dot(L, L) - sphere.radius * sphere.radius;

    float discriminant = b * b - 4.0 * a * c;
    if (discriminant < 0.0) return false;

    float sqrtD = sqrt(discriminant);
    float t0 = (-b - sqrtD) / (2.0 * a);
    float t1 = (-b + sqrtD) / (2.0 * a);

    t = (t0 > EPS) ? t0 : ((t1 > EPS) ? t1 : -1.0);
    if (t < 0.0) return false;

    hitPoint = rayOrigin + t * rayDir;
    hitNormal = normalize(hitPoint - sphere.center);
    return true;
}

// =============================================================================
// TRIANGLE INTERSECTION TEST (Möller–Trumbore)
// =============================================================================

bool TestTriangleIntersection(float3 rayOrigin, float3 rayDir, GPUObject tri, out float t, out float3 hitPoint, out float3 hitNormal)
{
    t = -1.0;
    hitPoint = float3(0, 0, 0);
    hitNormal = float3(0, 0, 0);

    float3 e1 = tri.v1 - tri.v0;
    float3 e2 = tri.v2 - tri.v0;
    float3 pvec = cross(rayDir, e2);
    float det = dot(e1, pvec);

    if (abs(det) < EPS) return false;

    float invDet = 1.0 / det;
    float3 tvec = rayOrigin - tri.v0;
    float u = dot(tvec, pvec) * invDet;

    if (u < -EPS || u > 1.0 + EPS) return false;

    float3 qvec = cross(tvec, e1);
    float v = dot(rayDir, qvec) * invDet;

    if (v < -EPS || u + v > 1.0 + EPS) return false;

    t = dot(e2, qvec) * invDet;
    if (t <= EPS) return false;

    hitPoint = rayOrigin + t * rayDir;
    hitNormal = normalize(cross(e1, e2));
    return true;
}

// =============================================================================
// BOX INTERSECTION TEST (AABB)
// =============================================================================

bool TestBoxIntersection(float3 rayOrigin, float3 rayDir, GPUObject box, out float t, out float3 hitPoint, out float3 hitNormal)
{
    t = -1.0;
    hitPoint = float3(0, 0, 0);
    hitNormal = float3(0, 0, 0);

    float3 localOrigin = mul(box.invMatWorld, float4(rayOrigin, 1.0)).xyz;
    float3 localDir = mul(box.invMatWorld, float4(rayDir, 0.0)).xyz;

    float tnear = -1e20;
    float tfar = 1e20;

    for (int i = 0; i < 3; i++)
    {
        float origin = localOrigin[i];
        float dir = localDir[i];
        float minVal = box.min[i];
        float maxVal = box.max[i];

        if (abs(dir) < EPS)
        {
            if (origin < minVal || origin > maxVal)
                return false;
        }
        else
        {
            float t1 = (minVal - origin) / dir;
            float t2 = (maxVal - origin) / dir;
            if (t1 > t2)
            {
                float tmp = t1;
                t1 = t2;
                t2 = tmp;
            }

            tnear = max(tnear, t1);
            tfar = min(tfar, t2);

            if (tnear > tfar || tfar < 0.0)
                return false;
        }
    }

    float tLocal = (tnear > EPS) ? tnear : tfar;
    if (tLocal <= EPS) return false;

    float3 localPoint = localOrigin + tLocal * localDir;
    hitPoint = mul(box.matWorld, float4(localPoint, 1.0)).xyz;

    float3 localNormal = float3(0, 0, 0);
    if (abs(localPoint.x - box.max.x) < EPS) localNormal.x = 1.0;
    else if (abs(localPoint.x - box.min.x) < EPS) localNormal.x = -1.0;
    else if (abs(localPoint.y - box.max.y) < EPS) localNormal.y = 1.0;
    else if (abs(localPoint.y - box.min.y) < EPS) localNormal.y = -1.0;
    else if (abs(localPoint.z - box.max.z) < EPS) localNormal.z = 1.0;
    else if (abs(localPoint.z - box.min.z) < EPS) localNormal.z = -1.0;

    hitNormal = normalize(mul(box.invTranspMatWorld, float4(localNormal, 0.0)).xyz);

    t = length(hitPoint - rayOrigin);
    return true;
}

// =============================================================================
// BVH TRAVERSAL (stack-based)
// =============================================================================

Hit TraceRayBVH(float3 rayOrigin, float3 rayDir, int depth)
{
    Hit hit;
    hit.found = false;
    hit.tmin = 1e20;
    hit.point = float3(0, 0, 0);
    hit.normal = float3(0, 0, 0);
    hit.material = (GPUMaterial)0;
    hit.objectIndex = -1;

    if (bvhNodeCount <= 0)
        return hit; // No BVH, return empty hit

    // Stack-based traversal
    int stack[MAX_BVH_STACK];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // Start from root

    while (stackPtr > 0)
    {
        int nodeIdx = stack[--stackPtr];
        if (nodeIdx < 0 || nodeIdx >= bvhNodeCount)
            continue;

        BVHNode node = bvhNodes[nodeIdx];

        // Test AABB intersection
        float tEnter, tExit;
        if (!IntersectAABB(rayOrigin, rayDir, node.aabbMin, node.aabbMax, tEnter, tExit))
            continue;

        // Skip if AABB is behind current hit
        if (tEnter > hit.tmin)
            continue;

        // Leaf node: test primitives
        if (node.leftChild == -1 && node.rightChild == -1)
        {
            for (int i = 0; i < node.primitiveCount; i++)
            {
                int primIdx = node.firstPrimitive + i;
                if (primIdx < 0 || primIdx >= bvhPrimitiveCount)
                    continue;

                int objIdx = bvhPrimitives[primIdx];
                if (objIdx < 0 || objIdx >= objectCount)
                    continue;

                GPUObject obj = objects[objIdx];
                float t;
                float3 hitPoint, hitNormal;
                bool intersection = false;

                if (obj.type == 0) // Sphere
                    intersection = TestSphereIntersection(rayOrigin, rayDir, obj, t, hitPoint, hitNormal);
                else if (obj.type == 1) // Triangle
                    intersection = TestTriangleIntersection(rayOrigin, rayDir, obj, t, hitPoint, hitNormal);
                else if (obj.type == 2) // Box
                    intersection = TestBoxIntersection(rayOrigin, rayDir, obj, t, hitPoint, hitNormal);

                if (intersection && t < hit.tmin)
                {
                    hit.found = true;
                    hit.tmin = t;
                    hit.point = hitPoint;
                    hit.normal = hitNormal;
                    hit.material = materials[obj.materialIndex];
                    hit.objectIndex = objIdx;
                }
            }
        }
        else // Internal node: push children
        {
            if (node.rightChild != -1 && stackPtr < MAX_BVH_STACK)
                stack[stackPtr++] = node.rightChild;

            if (node.leftChild != -1 && stackPtr < MAX_BVH_STACK)
                stack[stackPtr++] = node.leftChild;
        }
    }

    return hit;
}

// =============================================================================
// PRIMARY RAY TRACING (with BVH)
// =============================================================================

Hit TraceRay(float3 rayOrigin, float3 rayDir, int depth)
{
    // Use BVH if available, otherwise fallback to brute-force
    if (bvhNodeCount > 0)
        return TraceRayBVH(rayOrigin, rayDir, depth);

    // Fallback: brute-force
    Hit hit;
    hit.found = false;
    hit.tmin = 1e20;
    hit.point = float3(0, 0, 0);
    hit.normal = float3(0, 0, 0);
    hit.material = (GPUMaterial)0;
    hit.objectIndex = -1;

    for (int i = 0; i < objectCount; i++)
    {
        GPUObject obj = objects[i];
        float t;
        float3 hitPoint, hitNormal;
        bool intersection = false;

        if (obj.type == 0)
            intersection = TestSphereIntersection(rayOrigin, rayDir, obj, t, hitPoint, hitNormal);
        else if (obj.type == 1)
            intersection = TestTriangleIntersection(rayOrigin, rayDir, obj, t, hitPoint, hitNormal);
        else if (obj.type == 2)
            intersection = TestBoxIntersection(rayOrigin, rayDir, obj, t, hitPoint, hitNormal);

        if (intersection && t < hit.tmin)
        {
            hit.found = true;
            hit.tmin = t;
            hit.point = hitPoint;
            hit.normal = hitNormal;
            hit.material = materials[obj.materialIndex];
            hit.objectIndex = i;
        }
    }

    return hit;
}

// =============================================================================
// SHADOW RAY TEST
// =============================================================================

bool IsInShadow(float3 shadowOrigin, float3 lightDir, float lightDist)
{
    float3 shadowRayDir = normalize(lightDir);
    Hit shadowHit = TraceRay(shadowOrigin, shadowRayDir, 0);

    if (shadowHit.found && shadowHit.tmin > EPS && shadowHit.tmin < lightDist)
        return true;

    return false;
}

// =============================================================================
// COMPUTE SHADER MAIN
// =============================================================================

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)width || id.y >= (uint)height)
        return;

    float ndcX = ((id.x + 0.5f) / (float)width) * 2.0f - 1.0f;
    float ndcY = 1.0f - ((id.y + 0.5f) / (float)height) * 2.0f;

    float aspect = (float)width / (float)height;
    float tanFov2 = tan(fov * 0.5f);

    float px = ndcX * aspect * tanFov2;
    float py = ndcY * tanFov2;

    float3 rayDir = normalize(camForward + px * camRight + py * camUp);
    float3 rayOrigin = camPos;

    Hit primaryHit = TraceRay(rayOrigin, rayDir, MAX_TRACE_DEPTH);

    float3 finalColor = float3(0, 0, 0);

    if (primaryHit.found)
    {
        GPUMaterial mat = primaryHit.material;
        float3 hitPoint = primaryHit.point;
        float3 hitNormal = primaryHit.normal;

        finalColor = float3(0, 0, 0);

        // =====================================================================
        // LIGHT LOOP (AMBIENT + DIFFUSE + SHADOW)
        // =====================================================================
        for (int li = 0; li < lightCount; li++)
        {
            GPULight light = lights[li];

            finalColor += light.color * mat.color * mat.ambient;

            float3 L = light.position - hitPoint;
            float lightDist = length(L);
            L = normalize(L);

            float cosTheta = dot(hitNormal, L);

            if (cosTheta > 0.0)
            {
                float3 shadowOrigin = hitPoint + hitNormal * EPS;
                bool inShadow = IsInShadow(shadowOrigin, L, lightDist);

                if (!inShadow)
                {
                    finalColor += light.color * mat.color * mat.diffuse * cosTheta;
                }
            }
        }

        // =====================================================================
        // SPECULAR REFLECTION (recursive)
        // =====================================================================
        if (mat.specular > 0.0 && MAX_TRACE_DEPTH > 0)
        {
            float3 V = normalize(rayDir);
            float3 N = normalize(hitNormal);

            float cosThetaV = -dot(V, N);

            if (cosThetaV > 0.0)
            {
                float3 reflectDir = normalize(V + 2.0 * cosThetaV * N);
                float3 reflectOrigin = hitPoint + reflectDir * EPS;

                Hit reflectHit = TraceRay(reflectOrigin, reflectDir, MAX_TRACE_DEPTH - 1);

                if (reflectHit.found)
                {
                    float schlick = mat.specular + (1.0 - mat.specular) * pow(1.0 - cosThetaV, 5.0);
                    finalColor += mat.color * schlick * reflectHit.material.color;
                }
            }
        }

        // =====================================================================
        // REFRACTION (recursive)
        // =====================================================================
        if (mat.refraction > 0.0 && MAX_TRACE_DEPTH > 0)
        {
            float3 V = normalize(rayDir);
            float3 N = normalize(hitNormal);

            float cosThetaV = -dot(V, N);

            float etaI = 1.0;
            float etaT = mat.refractiveIndex;

            if (cosThetaV < 0.0)
            {
                cosThetaV = -cosThetaV;
                N = -N;
                etaI = mat.refractiveIndex;
                etaT = 1.0;
            }

            float eta = etaI / etaT;
            float k = 1.0 - eta * eta * (1.0 - cosThetaV * cosThetaV);

            if (k >= 0.0)
            {
                float cosThetaR = sqrt(k);
                float3 refractDir = normalize(eta * V + (eta * cosThetaV - cosThetaR) * N);
                float3 refractOrigin = hitPoint + refractDir * EPS;

                Hit refractHit = TraceRay(refractOrigin, refractDir, MAX_TRACE_DEPTH - 1);

                if (refractHit.found)
                {
                    finalColor += mat.color * mat.refraction * refractHit.material.color;
                }
            }
        }

        finalColor /= (float)lightCount;
    }
    else
    {
        finalColor = backgroundColor;
    }

    Result[id.xy] = float4(finalColor, 1.0);
}